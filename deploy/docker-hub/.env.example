# Generate a distinct value for each secret. RESEARCH_API_TOKENS accepts a comma-separated list.
RESEARCH_API_TOKENS=
RESEARCH_WORKER_TOKEN=
SEARXNG_SECRET=

RESEARCH_PUBLIC_BASE_URL=https://search.example.com
RESEARCH_OAUTH_ENABLED=1
RESEARCH_EU_PROXY=socks5://egress-xray:1080
RESEARCH_EXPECTED_COUNTRIES=RU=RU,EU=SE
SEARXNG_IMAGE=docker.io/searxng/searxng:latest
