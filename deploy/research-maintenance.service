[Unit]
Description=Research history retention and region readiness check
After=research-v2.service

[Service]
Type=oneshot
User=research-v2
WorkingDirectory=/opt/research-v2
EnvironmentFile=/etc/research-v2/research.env
ExecStart=/opt/research-v2/.venv/bin/python -m research_v2.maintenance
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/research-v2
PrivateTmp=true
