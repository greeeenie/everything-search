[Unit]
Description=Dedicated Chromium for the marketplace trial
Requires=marketplace-trial-egress.service
After=network-online.target marketplace-trial-egress.service

[Service]
User=marketplace-trial
Group=marketplace-trial
Environment=HOME=/var/lib/marketplace-trial
ExecStart=/usr/bin/xvfb-run -a -s "-screen 0 1280x800x24 -nolisten tcp" /usr/bin/chromium --remote-debugging-address=127.0.0.1 --remote-debugging-port=9223 --user-data-dir=/var/lib/marketplace-trial/chrome --no-first-run --no-default-browser-check --password-store=basic --disable-features=Translate --disable-gpu about:blank
Restart=always
RestartSec=5
StateDirectory=marketplace-trial
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
MemoryMax=1536M
TasksMax=384

[Install]
WantedBy=multi-user.target
